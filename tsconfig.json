-- ============================================================
-- SETUP SUPABASE — Pesquisa Pós-Tour TP Boas-Vindas
-- Execute no: Supabase Dashboard > SQL Editor > New Query
-- ============================================================

-- 1. RESPOSTAS DOS FORMULÁRIOS (tabela principal)
CREATE TABLE IF NOT EXISTS survey_submissions (
  id TEXT PRIMARY KEY,
  date TEXT NOT NULL DEFAULT '',
  nome_completo TEXT DEFAULT '',
  idade INTEGER DEFAULT 0,
  lider_educador TEXT DEFAULT '',
  produto TEXT DEFAULT '',
  participantes INTEGER DEFAULT 0,
  assistente TEXT DEFAULT '',
  unidade TEXT DEFAULT '',
  nota_clareza INTEGER DEFAULT 0,
  justificativa_clareza TEXT DEFAULT '',
  nota_acolhimento INTEGER DEFAULT 0,
  justificativa_acolhimento TEXT DEFAULT '',
  nota_assistente INTEGER DEFAULT 0,
  justificativa_assistente TEXT DEFAULT '',
  melhorias TEXT DEFAULT '',
  is_split_part BOOLEAN DEFAULT FALSE,
  original_tour_id TEXT DEFAULT '',
  is_second_leva BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMPTZ DEFAULT NOW()
);
ALTER TABLE survey_submissions ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "anon_all" ON survey_submissions;
CREATE POLICY "anon_all" ON survey_submissions FOR ALL TO anon USING (true) WITH CHECK (true);
ALTER PUBLICATION supabase_realtime ADD TABLE survey_submissions;

-- 2. AGENDA DE TOURS
CREATE TABLE IF NOT EXISTS tour_schedules (
  id TEXT PRIMARY KEY,
  title TEXT DEFAULT '',
  date TEXT DEFAULT '',
  time TEXT DEFAULT '',
  guide TEXT DEFAULT '',
  unit TEXT DEFAULT '',
  participants INTEGER DEFAULT 0,
  product TEXT DEFAULT '',
  notes TEXT DEFAULT '',
  status TEXT DEFAULT 'scheduled',
  created_at_val TEXT DEFAULT '',
  completed_at TEXT DEFAULT '',
  is_split_part BOOLEAN DEFAULT FALSE,
  original_tour_id TEXT DEFAULT '',
  reminder_minutes_override INTEGER,
  reminder_sound_type_override TEXT DEFAULT '',
  reminder_sound_enabled_override BOOLEAN,
  reminder_visual_enabled_override BOOLEAN,
  intervention_logs JSONB DEFAULT '[]'
);
ALTER TABLE tour_schedules ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "anon_all" ON tour_schedules;
CREATE POLICY "anon_all" ON tour_schedules FOR ALL TO anon USING (true) WITH CHECK (true);
ALTER PUBLICATION supabase_realtime ADD TABLE tour_schedules;

-- 3. AVISOS DO GESTOR
CREATE TABLE IF NOT EXISTS manager_notices (
  id TEXT PRIMARY KEY,
  title TEXT DEFAULT '',
  content TEXT DEFAULT '',
  date TEXT DEFAULT '',
  created_by TEXT DEFAULT '',
  priority TEXT DEFAULT 'medium',
  affected_unit TEXT DEFAULT ''
);
ALTER TABLE manager_notices ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "anon_all" ON manager_notices;
CREATE POLICY "anon_all" ON manager_notices FOR ALL TO anon USING (true) WITH CHECK (true);
ALTER PUBLICATION supabase_realtime ADD TABLE manager_notices;

-- 4. MENSAGENS DOS COLABORADORES
CREATE TABLE IF NOT EXISTS collaborator_messages (
  id TEXT PRIMARY KEY,
  sender_name TEXT DEFAULT '',
  sender_unit TEXT DEFAULT '',
  subject TEXT DEFAULT '',
  content TEXT DEFAULT '',
  date TEXT DEFAULT '',
  time TEXT DEFAULT '',
  is_read BOOLEAN DEFAULT FALSE
);
ALTER TABLE collaborator_messages ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "anon_all" ON collaborator_messages;
CREATE POLICY "anon_all" ON collaborator_messages FOR ALL TO anon USING (true) WITH CHECK (true);
ALTER PUBLICATION supabase_realtime ADD TABLE collaborator_messages;

-- 5. RELATÓRIOS DIÁRIOS
CREATE TABLE IF NOT EXISTS daily_reports (
  id TEXT PRIMARY KEY,
  collaborator_name TEXT DEFAULT '',
  date TEXT DEFAULT '',
  unit TEXT DEFAULT '',
  activities TEXT DEFAULT '',
  timestamp_val TEXT DEFAULT ''
);
ALTER TABLE daily_reports ENABLE ROW LEVEL SECURITY;
DROP POLICY IF EXISTS "anon_all" ON daily_reports;
CREATE POLICY "anon_all" ON daily_reports FOR ALL TO anon USING (true) WITH CHECK (true);
ALTER PUBLICATION supabase_realtime ADD TABLE daily_reports;

-- ✅ Setup concluído! Todas as tabelas criadas com RLS e Realtime habilitados.
